{
    "manifest_version": 3,
    "name": "Dollop Cast",
    "version": "1.1",
    "description": "Auto-detect video streams and cast to DLNA TV.",
    "permissions": [
        "activeTab",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}